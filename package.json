{
  "name": "homebridge-switchbot-k10plus-vacuum",
  "displayName": "SwitchBot K10+ Vacuum",
  "version": "1.0.4",
  "description": "Homebridge plugin for SwitchBot K10+ vacuum controls with status polling and room scene switches",
  "main": "dist/index.js",
  "engines": {
    "homebridge": ">=1.7.0",
    "node": ">=18.0.0"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge-platform",
    "switchbot",
    "vacuum",
    "k10+",
    "homekit"
  ],
  "author": "poke",
  "license": "mit",
  "peerDependencies": {
    "homebridge": ">=1.7.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "homebridge": "^1.7.0"
  },
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=cjs --external:homebridge --outfile=dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "config.schema.json",
    "README.md"
  ]
